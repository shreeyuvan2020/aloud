generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Assignment {
  id        String @id @default(cuid()) @map("_id")
  title     String
  prompt    String?
  essayText String

  // JSON-encoded strings rather than Json fields.
  analysis   String // { thesis, claims[], keyDetails[], signatureDetails[] }
  questions  String // [{ id, text, targets, kind }]
  teacherToken String @unique // groups one batch of assignments on a single results page
  studentToken String @unique // the one-time link a student opens

  // GoogleAccount that owns the results. Null on rows created before sign-in
  // existed; the first teacher to open such a results link claims it.
  ownerId String?

  // Who the assignment is for, so that student can sign in and find it instead
  // of needing the link. A Classroom import knows the Google user id; a pasted
  // essay only has whatever email the teacher typed (lowercased).
  studentGoogleId String?
  studentEmail    String?

  createdAt DateTime @default(now())
  sessions  Session[]

  @@index([ownerId, createdAt])
  @@index([studentGoogleId])
  @@index([studentEmail])
}

model GoogleAccount {
  id           String   @id @default(cuid()) @map("_id")
  googleUserId String   @unique
  email        String
  name         String?
  // Null until the teacher connects Classroom; plain sign-in doesn't need one.
  refreshToken String?
  scopes       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Session {
  id           String     @id @default(cuid()) @map("_id")
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  studentName String?

  // JSON-encoded [{ role: 'ai'|'student', text, ts }]
  transcript  String    @default("[]")
  status      String    @default("in_progress") // in_progress | complete

  /**
   * Unguessable per-session authorisation. A session id alone must not be
   * enough to read a transcript, submit answers, or force grading.
   * Null on rows created before this column existed; those are treated as
   * inaccessible, the correct posture for the bug they predate.
   */
  sessionKey String?

  // Set when the student was signed in, so their assigned list can show "Done".
  studentAccountId String?

  // JSON-encoded per-question scoring.
  grading String?

  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@index([assignmentId, createdAt])
}