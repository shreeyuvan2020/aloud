# Hack Club AI — https://ai.hackclub.com
# Get a key at https://ai.hackclub.com after signing in with Hack Club.
# Docs: https://docs.ai.hackclub.com
HACK_CLUB_AI_API_KEY=sk-hc-v1-your-key-here
HACK_CLUB_AI_BASE_URL=https://ai.hackclub.com/proxy/v1

# Verified working:
#   LLM      qwen/qwen3-32b             (chat completions; ~3.7s per turn)
#   STT      qwen/qwen3.8-omni-flash    (accepts audio input; ~4s)
#   TTS      resemble-ai/chatterbox-pro (Replicate; input field is `prompt`)
#   TTS alt  minimax/speech-02-turbo    (Replicate; `emotion` is a fixed enum)
# Keep LLM and STT separate: the omni model also works as an LLM but is ~3x
# slower, and that latency is dead air while a student waits to be re-questioned.
HCAI_LLM_MODEL=qwen/qwen3-32b
HCAI_STT_MODEL=qwen/qwen3.8-omni-flash
HCAI_TTS_MODEL=resemble-ai/chatterbox-pro
# chatterbox-pro voices: Luna, Ember, Hem, Aurora, Cliff, Josh,
#                        "William (Whispering)", Orion, Ken
HCAI_TTS_VOICE=Aurora

# file:./dev.db for SQLite. For Postgres use the postgres:// URL from Neon/Supabase.
DATABASE_URL="file:./dev.db"

# Google Classroom import — all optional, only needed for /teacher/import.
# Console setup: create a project, enable the Classroom API and the Docs API,
# then create an OAuth client of type "Web application".
#
# Scopes requested (see src/lib/google.ts for why drive.readonly is avoided):
#   classroom.courses.readonly
#   classroom.coursework.students.readonly
#   classroom.student-submissions.students.readonly
#   documents.readonly
#
# NOTE: while the OAuth app is in "Testing" status, Google issues refresh tokens
# that expire after 7 days, so a connected teacher must reconnect weekly. To
# ship to real schools, publish the consent screen as External/In production and
# complete verification (privacy policy + demo video; a few business days).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI exactly. No fragments, no wildcards.
#   dev:     http://localhost:3000/api/google/callback
#   prod:    https://yourdomain.com/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# Signs the teacher session cookie set after OAuth. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
G_SESSION_SECRET=
